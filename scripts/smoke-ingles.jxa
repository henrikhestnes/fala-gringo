// Headless smoke test for the /ingles/ subpage — same harness as smoke.jxa,
// same shared DOM stub, but loading the subpage's script set with the
// configuration globals its index.html sets before the engine:
//
//   osascript -l JavaScript scripts/smoke-ingles.jxa
ObjC.import('Foundation');

function read(p) {
  const s = $.NSString.stringWithContentsOfFileEncodingError($(p), $.NSUTF8StringEncoding, null);
  if (!s || s.isNil()) throw new Error('cannot read ' + p);
  return ObjC.unwrap(s);
}
const ROOT = ObjC.unwrap($.NSFileManager.defaultManager.currentDirectoryPath);

/* What ingles/index.html's inline config block does, reduced to what the steps
   assert on (full PT wording lives only in the shell — the tests only prove
   the overrides thread through the engine). */
const CONFIG =
  "window.APP_LANG = 'en-US';\n" +
  "window.APP_STORE_KEY = 'fg-ingles:v1';\n" +
  "window.APP_SYNC_APP = 'ingles';\n" +
  "window.APP_STRINGS = { answerIs: 'A resposta é', masteredLine: '{n} de {total} cartas dominadas', statKnown: 'Certas', " +
  "focoNew: '{n} novas', focoDue: '{n} p/ revisar', emptyFocoWaiting: '{n} esperam por amanhã', " +
  "syncTitleOff: 'Sync desligado — toque para conectar seus aparelhos' };\n";

const FILES = [
  'scripts/dom-stub.js',
  null,  // CONFIG slots in here, after the stub creates `window`
  'js/lib/text.js', 'js/lib/tts.js', 'js/lib/stt.js', 'js/lib/fx.js', 'js/progress.js',
  'ingles/js/data/irregulares.js', 'ingles/js/data/phrasal.js', 'ingles/js/topics.js',
  'js/quiz.js', 'js/app.js', 'js/lib/sync.js', 'js/version.js',
  'scripts/smoke-ingles-steps.js'
];

var results = [];
function step(name, fn) {
  try { const d = fn(); results.push({ ok: true, name: name, detail: d || '' }); }
  catch (e) { results.push({ ok: false, name: name, detail: (e && e.message) || String(e) }); }
}

var geval = eval;

try {
  geval(FILES.map(function (f) {
    return f === null ? '/* inline config */\n' + CONFIG
                      : '/* ' + f + ' */\n' + read(ROOT + '/' + f);
  }).join('\n;\n'));
} catch (e) {
  results.push({ ok: false, name: 'load/eval', detail: (e && e.message) || String(e) });
}

results.forEach(r => {
  console.log((r.ok ? '  ok  ' : 'FAIL  ') + r.name);
  if (r.detail) String(r.detail).split('\n').forEach(l => console.log('        ' + l));
});
const failed = results.filter(r => !r.ok).length;
console.log('');
console.log(failed ? ('FAILED: ' + failed + ' of ' + results.length)
                   : ('PASSED: all ' + results.length + ' smoke steps'));
