// Headless smoke test: runs the actual app code against a minimal DOM stub, using
// the JavaScriptCore engine bundled with macOS — no Node, no npm:
//
//   osascript -l JavaScript scripts/smoke.jxa
//
// The DOM stub lives in scripts/dom-stub.js (shared with smoke-ingles.jxa);
// steps live in scripts/smoke-steps.js.
// Not a browser, but it exercises every render path, the answer-checking, mode
// toggling, tab routing and the daily challenge — enough to catch reference
// errors and logic faults without opening a page.
ObjC.import('Foundation');

function read(p) {
  const s = $.NSString.stringWithContentsOfFileEncodingError($(p), $.NSUTF8StringEncoding, null);
  if (!s || s.isNil()) throw new Error('cannot read ' + p);
  return ObjC.unwrap(s);
}
const ROOT = ObjC.unwrap($.NSFileManager.defaultManager.currentDirectoryPath);

const FILES = [
  'scripts/dom-stub.js',
  'js/lib/text.js', 'js/lib/tts.js', 'js/lib/stt.js', 'js/lib/fx.js', 'js/progress.js', 'js/conjugate.js',
  'js/data/verbs.js', 'js/data/pronominal.js', 'js/data/nouns.js', 'js/data/adjectives.js', 'js/data/adverbs.js',
  'js/data/connecting.js', 'js/data/numbers.js', 'js/data/glossary.js', 'js/data/sentences.js',
  'js/topics.js', 'js/infer.js', 'js/quiz.js', 'js/browse.js', 'js/daily.js', 'js/milestones.js', 'js/app.js', 'js/lib/sync.js',
  'js/version.js',
  'scripts/smoke-steps.js'
];

var results = [];
function step(name, fn) {
  try { const d = fn(); results.push({ ok: true, name: name, detail: d || '' }); }
  catch (e) { results.push({ ok: false, name: name, detail: (e && e.message) || String(e) }); }
}

var geval = eval;

try {
  // stub + app + steps in ONE eval: the stub's and the app's top-level const
  // bindings (registry, document, Mode, Store, Quiz, TOPICS, …) are only
  // visible within the same eval scope.
  geval(FILES.map(function (f) { return '/* ' + f + ' */\n' + read(ROOT + '/' + f); }).join('\n;\n'));
} catch (e) {
  results.push({ ok: false, name: 'load/eval', detail: (e && e.message) || String(e) });
}

/* -------------------------------------------------------------- report -- */

results.forEach(r => {
  console.log((r.ok ? '  ok  ' : 'FAIL  ') + r.name);
  if (r.detail) String(r.detail).split('\n').forEach(l => console.log('        ' + l));
});
const failed = results.filter(r => !r.ok).length;
console.log('');
console.log(failed ? ('FAILED: ' + failed + ' of ' + results.length)
                   : ('PASSED: all ' + results.length + ' smoke steps'));
