// Headless runner for js/checks.js, using the JavaScriptCore engine that ships
// with macOS — no Node, no npm, nothing to install:
//
//   osascript -l JavaScript scripts/check.jxa
//
// verify.html runs the exact same checks in the browser.

ObjC.import('Foundation');

function read(path) {
  const s = $.NSString.stringWithContentsOfFileEncodingError(
    $(path), $.NSUTF8StringEncoding, null);
  if (!s || s.isNil()) throw new Error('cannot read ' + path);
  return ObjC.unwrap(s);
}

function scriptDir() {
  const cwd = ObjC.unwrap($.NSFileManager.defaultManager.currentDirectoryPath);
  return cwd;
}

const ROOT = scriptDir();
const FILES = [
  'js/lib/text.js',
  'js/conjugate.js',
  'js/data/verbs.js',
  'js/data/pronominal.js',
  'js/data/nouns.js',
  'js/data/adjectives.js',
  'js/data/adverbs.js',
  'js/data/connecting.js',
  'js/data/numbers.js',
  'js/data/glossary.js',
  'js/data/sentences.js',
  'js/topics.js',
  'js/checks.js'
];

// the data files assign onto `window`; give them one
var window = this;
var geval = eval;

// All files are concatenated into ONE evaluation: top-level `const`/`let` inside an
// eval do not outlive that eval, so loading them separately would hide TOPICS etc.
var sources = [];
var loadFailed = false;
FILES.forEach(function (f) {
  try {
    sources.push('/* ' + f + ' */\n' + read(ROOT + '/' + f));
  } catch (e) {
    console.log('READ ERROR  ' + f + ': ' + ((e && e.message) || e));
    loadFailed = true;
  }
});

var results = null;
if (!loadFailed) {
  try {
    results = geval(sources.join('\n;\n') + '\n;runChecks();');
  } catch (e) {
    console.log('EVAL ERROR: ' + ((e && e.message) || e));
    loadFailed = true;
  }
}

/* The service worker's CORE list is hand-maintained and cache.addAll() is
   all-or-nothing: one missing path and no installed user ever gets the new
   version. Check every CORE entry exists and every <script src> in the three
   shells is in it. */
if (results) {
  const name = 'sw.js CORE lists every shell script and every entry exists';
  try {
    const fm = $.NSFileManager.defaultManager;
    const exists = p => fm.fileExistsAtPath($(ROOT + '/' + p));
    const sw = read(ROOT + '/sw.js');
    const list = (sw.match(/const CORE = \[([\s\S]*?)\];/) || [, ''])[1];
    const core = (list.match(/'[^']+'/g) || []).map(s => s.slice(1, -1));
    const missing = core.filter(p => !exists(p.endsWith('/') ? p + 'index.html' : p));
    const shells = [['', 'index.html'], ['ingles/', 'ingles/index.html'], ['noruegues/', 'noruegues/index.html']];
    const uncached = [];
    shells.forEach(([dir, file]) => {
      const html = read(ROOT + '/' + file);
      (html.match(/<script src="([^"]+)"/g) || []).forEach(tag => {
        const src = tag.match(/"([^"]+)"/)[1];
        const path = src.startsWith('../') ? src.slice(3) : dir + src;
        if (!core.includes(path)) uncached.push(file + ' → ' + path);
      });
      if (!core.includes(dir || './')) uncached.push(file + ' (the page itself)');
    });
    const bad = missing.map(p => 'missing file: ' + p).concat(uncached.map(p => 'not in CORE: ' + p));
    results.push({ ok: !bad.length && core.length > 10, name: name, detail: bad.length ? bad.join('\n') : core.length + ' cached paths' });
  } catch (e) {
    results.push({ ok: false, name: name, detail: String((e && e.message) || e) });
  }
}

if (loadFailed || !results) {
  console.log('\nAborting: one or more files failed to parse or execute.');
} else {
  const failed = results.filter(r => !r.ok);
  results.forEach(r => {
    console.log((r.ok ? '  ok  ' : 'FAIL  ') + r.name);
    if (r.detail) {
      r.detail.split('\n').forEach(line => console.log('        ' + line));
    }
  });
  console.log('');
  console.log(failed.length
    ? 'FAILED: ' + failed.length + ' of ' + results.length + ' checks'
    : 'PASSED: all ' + results.length + ' checks');
}

// A printed failure must also fail shell/CI callers.
if (!results || results.some(r => !r.ok) || loadFailed) throw new Error('Check suite failed');
